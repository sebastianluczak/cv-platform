OPENROUTER_API_KEY=sk-or-v1-KEY
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MODEL=nvidia/nemotron-3-super-120b-a12b:free
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=cv-platform-queue
NATS_URL=nats://localhost:4222

# Metrics - to avoid port collisions in devenv
METRICS_PORT_AIWEIGHTER=8051
METRICS_PORT_DATACLEANER=8052
METRICS_PORT_EXTRACTOR=8053
METRICS_PORT_OFFERMATCHER=8054
METRICS_PORT_PIISTRIPPER=8055
METRICS_PORT_SKILLMATCHER=8056
METRICS_PORT_UPLOADER=8057
METRICS_PORT_ROLEINSIGHTS=8058
ROLEINSIGHTS_PORT=8083

# Datacleaner service - data retention and cleanup
RETENTION_UPLOADS_DAYS=7
RETENTION_REDACTED_DAYS=7
RETENTION_FAILED_QUEUE_DAYS=7
CLEANUP_INTERVAL_MINUTES=1
DRY_RUN=false
